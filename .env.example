# Komga Service Configuration
# Copy this file to .env and update values before deployment

# Port Configuration (REQUIRED)
# Port Komga will be accessible on
# Default: 8081 (maps to container port 25600)
KOMGA_PORT=8081

# Media Path (REQUIRED)
# Absolute path to your comics/manga collection on the host
# This will be mounted read-only into the container at /data
# Example: /home/jayblack388/media/comics
KOMGA_MEDIA_PATH=/home/jayblack388/media/comics

# User/Group ID (REQUIRED)
# Should match your host user to avoid permission issues
# Find your user ID with: id -u
# Find your group ID with: id -g
# Default: 1000 (typical for first user on Linux)
PUID=1000
PGID=1000

# Timezone (OPTIONAL)
# Set to your local timezone for correct timestamps
# Format: Region/City (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# Default: America/New_York
TZ=America/New_York
